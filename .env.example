# ==========================================
# DeFiGuard Environment Configuration Template
# ==========================================

# Backend Settings
APP_ENV=development
APP_SECRET_KEY=change_this_to_a_secure_random_string_in_production_32_bytes_min
PORT=8000
HOST=0.0.0.0

# Database Configuration
# In local development without PostgreSQL, use SQLite: sqlite:///./defiguard.db
# In PostgreSQL environments: postgresql+psycopg://postgres:postgres@localhost:5432/defiguard
DATABASE_URL=sqlite:///./defiguard.db

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Blockchain & Web3 (Phase 2 & 4)
EVM_CHAIN_ID=1337
EVM_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_EVM_CHAIN_ID=1337
NEXT_PUBLIC_EXPLORER_URL=https://sepolia.etherscan.io

# External & Scanner Services
MARKET_DATA_API_KEY=
SLITHER_ENABLED=false
